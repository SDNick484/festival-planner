# Festival Planner secrets and environment. Copy to .env, which is gitignored.
# All values are fictional placeholders.

# Path to the instance settings file (default: ./config.toml).
# FP_CONFIG=config.toml

# Cloudflare Access: the team domain and the application audience (AUD) tag.
CF_TEAM_DOMAIN=example-team.example.com
CF_AUD=replace-with-the-access-application-aud-tag

# Machine tokens for the MCP endpoint: name:scope:secret, comma separated.
# name: lowercase letters, digits, - or _ (not web, email or system). scope: read or write.
# secret: at least 24 characters, no spaces or slashes, and unique across entries.
# Several entries may share a name so that a token can be rotated.
MCP_TOKENS=claude:write:replace-with-a-long-random-secret,duet:read:replace-with-another-long-secret

# Mailbox and SMTP passwords (app passwords). Host and user live in config.toml.
IMAP_PASSWORD=replace-with-an-app-password
SMTP_PASSWORD=replace-with-an-app-password

# Local development only: bypasses Access. It must be one of the organizers in config.toml.
# Loading the config refuses it unless FLASK_ENV=development; startup also requires the app to be
# bound to a loopback address.
# FLASK_ENV=development
# DEV_AUTH_EMAIL=organizer-a@example.com
